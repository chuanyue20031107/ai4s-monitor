# WeRSS standalone service
WERSS_IMAGE=docker.io/franklin888/werss
WERSS_IMAGE_TAG=latest
WERSS_CONTAINER_NAME=ai4s-werss
WERSS_PUBLISH_PORT=8001
WERSS_DATA_DIR=./data/werss-data
WERSS_LOGS_DIR=./data/werss-logs
WERSS_DB=sqlite:///data/db.db
WERSS_USERNAME=admin
WERSS_PASSWORD=change-me
WERSS_BROWSER_TYPE=firefox
WERSS_DEBUG=False
WERSS_AUTO_RELOAD=False

# GitHub Actions crawler reads this value from repository secret WERSS_BASE_URL.
# It must be the public HTTPS origin that can be reached from GitHub-hosted runners.
# Example: https://werss.example.com/
