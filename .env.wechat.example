# WeRSS sidecar
WERSS_IMAGE=docker.io/franklin888/werss
WERSS_IMAGE_TAG=latest
WERSS_CONTAINER_NAME=ai4s-werss
WERSS_PUBLISH_PORT=8001
WERSS_DATA_DIR=./data/werss-data
WERSS_LOGS_DIR=./data/werss-logs
WERSS_DB=sqlite:///data/db.db
WERSS_USERNAME=admin
WERSS_PASSWORD=change-me
WERSS_BROWSER_TYPE=firefox
WERSS_DEBUG=False
WERSS_AUTO_RELOAD=False

# Used by scripts/sync-wechat-rss.mjs
# AI4S_BASE_URL is the deployed AI4S Monitor HTTP origin.
AI4S_BASE_URL=http://localhost:3000/
# WERSS_BASE_URL must be reachable by the AI4S Monitor server process.
WERSS_BASE_URL=http://localhost:8001/
# Set true first to preview DB changes without writing them.
DRY_RUN=true
